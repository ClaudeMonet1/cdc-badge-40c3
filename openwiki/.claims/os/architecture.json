    {
      "id": "claim_82cc0f45faf949b185e3ad151a021801",
      "statement": "app_main boots in stages: NVS and build-profile check, core services, RTC, hardware peripherals (with a TROPIC01 factory wipe on profile change), system services, display and UI, modules, the plugin system, BLE barrier release, then the main loop.",
