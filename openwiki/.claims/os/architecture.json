          "version": "repo-lines-v1:sha256:19914b7b357e0ede8fe1d0bcd95cbf5730263886c26a9cb9f355b09b97e4749a:"
        }
      ]
    },
    {
      "id": "claim_eb3995a5a71f4bdebfc4d8a13a5438ce",
      "statement": "The main task runs a cooperative 10 ms loop that enforces system lockdown, drains the EventBus, services the serial console and power manager, runs the UI, ticks attestation and message transfer, and dispatches a tick to all modules.",
      "evidence": [
        {
          "resource": "repo://references/cdc-badge-os/main/main.cpp#L615-L651",
          "version": "repo-lines-v1:sha256:b219fcbed0b1cc77cb113fefd5d1145b52ee63d8c0969e1151af5764febba9b7:"
        }
      ]
    },
